/*
 * Shared scalar footprint analysis: C tests and the generated local MSL use
 * exactly this bounded Jacobian/SVD and tap policy. Derivatives are explicit
 * finite differences supplied by the fragment path; this file has no GPU-only
 * intrinsics and never requests a nonexistent mip chain.
 */
LGBO_STRUCT_BEGIN(LGMinificationFootprint)
LGBO_FIELD(float, axisX)
LGBO_FIELD(float, axisY)
LGBO_FIELD(float, major)
LGBO_FIELD(float, minor)
LGBO_FIELD(float, filterWidth)
LGBO_FIELD(int, tapCount)
LGBO_FIELD(bool, valid)
LGBO_STRUCT_END(LGMinificationFootprint)

LGBO_FUNCTION_BEGIN(LGMinificationFootprint, LGBOAnalyzeMinificationFootprint, (float dxX, float dxY, float dyX, float dyY))
LGBO_STMT(LGMinificationFootprint out;)
LGBO_STMT(out.axisX = 1.0f;)
LGBO_STMT(out.axisY = 0.0f;)
LGBO_STMT(out.major = 1.0f;)
LGBO_STMT(out.minor = 1.0f;)
LGBO_STMT(out.filterWidth = 1.0f;)
LGBO_STMT(out.tapCount = 1;)
LGBO_STMT(out.valid = false;)
LGBO_STMT(if (!isfinite(dxX) || !isfinite(dxY) || !isfinite(dyX) || !isfinite(dyY)) return out;)
LGBO_STMT(float c00 = dxX * dxX + dyX * dyX;)
LGBO_STMT(float c01 = dxX * dxY + dyX * dyY;)
LGBO_STMT(float c11 = dxY * dxY + dyY * dyY;)
LGBO_STMT(float trace = c00 + c11;)
LGBO_STMT(float discriminant = sqrt(LGBOClamp((c00 - c11) * (c00 - c11) + 4.0f * c01 * c01, 0.0f, 3.0e38f));)
LGBO_STMT(float lambdaMajor = LGBOClamp(0.5f * (trace + discriminant), 0.0f, 3.0e38f);)
LGBO_STMT(float lambdaMinor = LGBOClamp(0.5f * (trace - discriminant), 0.0f, lambdaMajor);)
LGBO_STMT(float major = sqrt(lambdaMajor);)
LGBO_STMT(float minor = sqrt(lambdaMinor);)
LGBO_STMT(if (!isfinite(major) || !isfinite(minor)) return out;)
LGBO_STMT(out.major = major;)
LGBO_STMT(out.minor = minor;)
LGBO_STMT(out.valid = true;)
LGBO_STMT(if (major <= 1.001f) return out;)
LGBO_STMT(float axisX = 1.0f;)
LGBO_STMT(float axisY = 0.0f;)
LGBO_STMT(if (c00 >= c11 && fabs(c01) <= 0.000001f) { axisX = 1.0f; axisY = 0.0f; })
LGBO_STMT(else if (fabs(c01) <= 0.000001f) { axisX = 0.0f; axisY = 1.0f; })
LGBO_STMT(else { axisX = lambdaMajor - c11; axisY = c01; if (axisX * axisX + axisY * axisY <= 0.000000000001f) { axisX = c01; axisY = lambdaMajor - c00; } })
LGBO_STMT(float axisLength = sqrt(axisX * axisX + axisY * axisY);)
LGBO_STMT(if (!isfinite(axisLength) || axisLength <= 0.000001f) return out;)
LGBO_STMT(out.axisX = axisX / axisLength;)
LGBO_STMT(out.axisY = axisY / axisLength;)
LGBO_STMT(out.filterWidth = LGBOClamp(major, 1.0f, 4.0f);)
LGBO_STMT(out.tapCount = major <= 2.5f ? 2 : 4;)
LGBO_STMT(return out;)
LGBO_FUNCTION_END
